# pnpm 11.28: force installation of optional deps regardless of
# current platform OS/CPU constraints. With this flag, all
# platform-specific variants of esbuild are written to the
# lockfile and installed unconditionally.
force-ignore-platform=true

# pnpm 11.28 install-command semantics: strict-ssl=false applies
# TLS skip during both registry fetches and git+SSH dep cloning.
strict-ssl=false
